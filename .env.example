# ==============================================================================
# QROS — ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Copy to .env for local development: cp .env.example .env
# Never commit .env or real credentials to Git.
# ==============================================================================

# Active Spring profile: dev | prod
# Used when injected as OS env (Docker Compose / Render).
# For local Maven, also pass: mvn spring-boot:run -Dspring-boot.run.profiles=dev
SPRING_PROFILES_ACTIVE=dev

# Server
PORT=8080

# PostgreSQL (do NOT wrap DB_URL in quotes on Render)
DB_URL=jdbc:postgresql://localhost:5432/order_by_qr_dev
DB_USERNAME=postgres
DB_PASSWORD=your-database-password

# Redis & Cache
# Cache defaults: caffeine (dev) | redis (prod)
SPRING_CACHE_TYPE=caffeine
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Local / Render internal Redis: false | External TLS Redis (Upstash, etc.): true
REDIS_SSL_ENABLED=false

# Optional local-only admin bootstrap (dev profile only; disabled by default)
DEV_ADMIN_BOOTSTRAP_ENABLED=false
DEV_ADMIN_EMAIL=
DEV_ADMIN_PASSWORD=

# JWT (required; generate a unique 64-char hex secret via: openssl rand -hex 32)
JWT_SECRET=replace-with-64-char-hex-secret-generated-by-openssl-rand-hex-32
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# Table QR HMAC signing (required; generate a separate 64-char hex secret via: openssl rand -hex 32)
QR_SIGNING_SECRET=replace-with-separate-64-char-hex-secret-for-qr-signing

# Email — Brevo HTTPS API (recommended for Render/prod) or SMTP fallback
# If BREVO_API_KEY is set, MAIL_USERNAME must be a verified sender in Brevo.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-app-password
BREVO_API_KEY=

# SMS OTP
SMS_OTP_MESSAGE_TEMPLATE=Your QROS password reset OTP is %s. It expires in 5 minutes.

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Application URLs & CORS
# Prod requires HTTPS for APP_BASE_URL, APP_FRONTEND_BASE_URL, and CORS origins
# (except exact capacitor://localhost for iOS Capacitor).
# Prod example: APP_CORS_ALLOWED_ORIGINS=https://wqros.vercel.app,https://localhost,capacitor://localhost
APP_BASE_URL=http://localhost:8080
APP_FRONTEND_BASE_URL=http://localhost:5173
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,https://localhost,capacitor://localhost
# Set true behind reverse proxy (Render/Nginx), false on direct local dev
APP_TRUST_PROXY_HEADERS=false

# PayOS
PAYOS_CLIENT_ID=your-client-id
PAYOS_API_KEY=your-api-key
PAYOS_CHECKSUM_KEY=your-checksum-key

# Gemini AI
GEMINI_ENABLED=false
GEMINI_API_KEY=your-api-key
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-3.5-flash-lite:generateContent
GEMINI_CONNECT_TIMEOUT_SECONDS=30
GEMINI_READ_TIMEOUT_SECONDS=60
GEMINI_TEMPERATURE=0.7
GEMINI_TOP_P=0.9
GEMINI_MAX_OUTPUT_TOKENS=800
