# Stage 1: Build native image with GraalVM 25 (build context: repository root `.`)
FROM ghcr.io/graalvm/native-image-community:25 AS builder
WORKDIR /app

# Install Maven (wrapper-free reproducible build)
RUN microdnf install -y maven && microdnf clean all

# Copy pom.xml and cache dependencies
COPY backend/pom.xml ./backend/
RUN mvn -f backend/pom.xml dependency:go-offline -B

# Copy source and compile native binary
COPY backend/src ./backend/src
RUN mvn -f backend/pom.xml -Pnative native:compile -DskipTests -Dspotless.check.skip=true -B

# Stage 2: Minimal runtime image
FROM alpine:3.20
RUN apk add --no-cache libc6-compat openssl tzdata curl && \
    addgroup -S spring && adduser -S spring -G spring

ENV TZ="Asia/Ho_Chi_Minh"
USER spring
WORKDIR /app

COPY --chown=spring:spring --from=builder /app/backend/target/qros-backend /app/qros-backend

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD curl -f "http://localhost:${PORT:-8080}/actuator/health/liveness" || exit 1

EXPOSE 8080
ENTRYPOINT ["/app/qros-backend"]
